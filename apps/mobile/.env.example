# Copia este archivo como .env y llena los valores de tu proyecto de Supabase
EXPO_PUBLIC_SUPABASE_URL=
# Project Settings → API Keys → Publishable key (sb_publishable_…). Es pública a propósito:
# viaja dentro de la app. Lo que protege los datos es RLS, no esta llave.
EXPO_PUBLIC_SUPABASE_KEY=

# URL del backend (apps/backend). Elige la línea que corresponda a cómo pruebas:
#   celular físico     → http://<IP-de-tu-PC-en-la-red>:3000   (ej. http://192.168.100.19:3000)
#   emulador Android   → http://10.0.2.2:3000
#   Expo web en la PC  → http://localhost:3000
# Con celular físico, la PC y el celular deben estar en la misma red Wi-Fi, y Windows debe
# permitir el puerto 3000 en el Firewall. La IP se consulta con `ipconfig`.
EXPO_PUBLIC_API_URL=

# Modo de prueba (opcional, solo desarrollo): muestra las opciones de admin y de voluntario
# sin tener esos roles en la base. Déjalo vacío o en false salvo que lo necesites.
EXPO_PUBLIC_DEV_ALL_ROLES=false
