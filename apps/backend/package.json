{
  "name": "backend",
  "version": "1.0.0",
  "description": "API de BAMX Conecta (Express + Supabase) con arquitectura por capas",
  "main": "dist/main.js",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "grant-admin": "ts-node-dev --transpile-only src/interfaces/cli/grantAdmin.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "license": "ISC",
  "dependencies": {
    "@supabase/supabase-js": "2.109.0",
    "dotenv": "^18.0.3",
    "express": "^5.2.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^20.19.43",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
