# Copia este archivo como .env (no se sube al repositorio)
PORT=3000
NODE_ENV=development

# Project Settings → API en el panel de Supabase
SUPABASE_URL=
# Llave service_role: acceso total que se salta RLS. Solo aquí, nunca en la app ni en git.
SUPABASE_SERVICE_ROLE_KEY=

# Orígenes permitidos para CORS separados por coma (ej. http://localhost:8081). Vacío = todos.
CORS_ORIGINS=
