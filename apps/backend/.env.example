# Copia este archivo como .env (no se sube al repositorio)
PORT=3000
NODE_ENV=development

# Project Settings → API en el panel de Supabase
SUPABASE_URL=
# Project Settings → API Keys → Secret keys (empieza con sb_secret_). En proyectos con llaves
# del formato viejo es la `service_role`. Se salta RLS: solo aquí, nunca en la app ni en git.
# NO pongas aquí la llave publicable (sb_publishable_): el backend quedaría con permisos de
# invitado y todos los endpoints de admin responderían 403.
SUPABASE_SECRET_KEY=

# Orígenes permitidos para CORS separados por coma (ej. http://localhost:8081). Vacío = todos.
CORS_ORIGINS=

# Asignación automática de recolecciones. Estos son los valores por omisión: solo hace falta
# ponerlos si BAMX quiere otros.
# Máximo de recolecciones que se le pueden asignar a un voluntario en un día.
ASSIGNMENT_MAX_PICKUPS_PER_DAY=5
# Kilómetros estimados máximos de su ruta diaria (línea recta x 1.3, no por calles).
ASSIGNMENT_MAX_ROUTE_KM=25
# Máximo de recolecciones al mes por voluntario, para repartir la carga.
ASSIGNMENT_MAX_PICKUPS_PER_MONTH=15
# Horas que tiene el voluntario para confirmar antes de que se le ofrezca a otro (1 a 24).
ASSIGNMENT_OFFER_HOURS=12
