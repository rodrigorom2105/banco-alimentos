# Copia este archivo como .env (no se sube al repositorio)
PORT=3000
NODE_ENV=development

# Project Settings → API en el panel de Supabase
SUPABASE_URL=
# Project Settings → API Keys → Secret keys (empieza con sb_secret_). En proyectos con llaves
# del formato viejo es la `service_role`. Se salta RLS: solo aquí, nunca en la app ni en git.
# NO pongas aquí la llave publicable (sb_publishable_): el backend quedaría con permisos de
# invitado y todos los endpoints de admin responderían 403.
SUPABASE_SECRET_KEY=

# Orígenes permitidos para CORS separados por coma (ej. http://localhost:8081). Vacío = todos.
CORS_ORIGINS=
